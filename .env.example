# Copy to .env for local dev. Vercel manages prod values via the dashboard.
# .env is gitignored.

# ---- Admin credentials (temporary — change after first deploy) ----
ADMIN_ID=snownoon
ADMIN_PW=snownoon

# ---- Session token signing secret ----
# Any long random string. Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-hex-string

# Optional: session token lifetime in hours (default 24)
SESSION_HOURS=24

# ---- Supabase (auto-populated by `vercel env pull .env`) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server port for local dev (default 4000). Ignored on Vercel.
# PORT=4000
