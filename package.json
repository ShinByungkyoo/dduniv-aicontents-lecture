{
  "name": "dduniv-aicontents-lecture",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev:api": "node --watch --env-file-if-exists=.env dev-server.js",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -k -n api,client -c green,cyan \"npm run dev:api\" \"npm run dev:client\"",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
